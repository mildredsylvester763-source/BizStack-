# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only Supabase administration. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# 32-byte encryption key, represented as 64 hex characters or base64.
BIZSTACK_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Protects the delivery worker / scheduled jobs.
CRON_SECRET=replace-with-a-long-random-secret

# Email provider
RESEND_API_KEY=
BIZSTACK_EMAIL_FROM=

# SMS provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=


# BizStack AI Engine — server-side only. Customers never need these keys.
# Auto routing can use any configured combination of providers.
BIZSTACK_AI_PROVIDER=auto
BIZSTACK_AI_MAX_TOKENS=8192
BIZSTACK_AI_TEMPERATURE=0.15
BIZSTACK_ANTHROPIC_API_KEY=
BIZSTACK_ANTHROPIC_MODEL=claude-sonnet-4-6
BIZSTACK_OPENAI_API_KEY=
BIZSTACK_OPENAI_MODEL=gpt-5
BIZSTACK_GEMINI_API_KEY=
BIZSTACK_GEMINI_MODEL=gemini-2.5-flash
BIZSTACK_MISTRAL_API_KEY=
BIZSTACK_MISTRAL_MODEL=mistral-large-latest
# Legacy single-provider fallback:
BIZSTACK_AI_API_URL=
BIZSTACK_AI_API_KEY=
BIZSTACK_AI_MODEL=

# Customer portal transactional email
BIZSTACK_PORTAL_EMAIL_FROM=
BIZSTACK_PORTAL_EMAIL_WEBHOOK_URL=

# OAuth app credentials — keep all client secrets server-side.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

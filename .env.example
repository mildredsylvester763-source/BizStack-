# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only Supabase administration. NEVER expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# 32-byte encryption key, represented as 64 hex characters or base64.
BIZSTACK_ENCRYPTION_KEY=replace-with-a-random-32-byte-key

# Protects the delivery worker / scheduled jobs.
CRON_SECRET=replace-with-a-long-random-secret

# Email provider
RESEND_API_KEY=
BIZSTACK_EMAIL_FROM=

# SMS provider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
